# cPanel / Apache Root Redirect to Public
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent direct access to sensitive files
<FilesMatch "^\.(env|git)">
    Order allow,deny
    Deny from all
</FilesMatch>
